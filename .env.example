# Copy to .env and fill in. Everything runs WITHOUT these (mock mode) — keys are opt-in.
# Never commit .env. Never paste keys into chat, issues, or PRs.

# --- LLM (NVIDIA Nemotron via the OpenAI-compatible NIM API) ---
# mock  = deterministic offline brain (default; CI and demo fallback)
# nvidia = real Nemotron calls
LLM_PROVIDER=mock
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Model IDs confirmed on /v1/models on 2026-11-08 — re-check before the demo.
NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b
NEMOTRON_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# --- Server ---
BEACON_PORT=8787
# How long the agent waits for a trusted contact to answer before giving up (ms).
VERIFY_TIMEOUT_MS=45000

# --- Photon Spectrum (messaging) — only needed for real iMessage ---
# From app.photon.codes → project settings.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# terminal = type messages in your shell (no credentials); imessage = real line
CHANNELS_PROVIDER=terminal
BEACON_SERVER_URL=http://localhost:8787
