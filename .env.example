# Copy to .env and fill in. Never commit .env. Never paste keys into chat, issues, or PRs.

# --- NVIDIA Nemotron (NIM, OpenAI-compatible API) ---
# REQUIRED for calls: the Magenta-Guard screener has no offline brain. Without a key
# every call ends as "couldn't screen this call" and is NOT connected.
# Key from build.nvidia.com.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Model IDs confirmed on /v1/models on 2026-11-08 — re-check before the demo.
NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b
NEMOTRON_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Legacy TEXT pipeline only (not calls): mock = offline rules brain, nvidia = Nemotron.
LLM_PROVIDER=mock

# --- Server ---
BEACON_PORT=8787
# Public tunnel URL for webhooks (e.g. ngrok, cloudflared).
PUBLIC_BASE_URL=
# How long the screener waits for the real contact to answer the callback (ms). Use 90000 for a live phone callback.
VERIFY_TIMEOUT_MS=45000
# Nemotron hidden reasoning for the screener. Off (default) = ~1 s per turn; true = 10-20 s per turn.
SCREENER_THINKING=false
# Name the screener uses in its greeting ("you've reached Rosa's phone"). Optional.
SUBSCRIBER_NAME=
# Trusted registry SQLite file. Default: data/registry.sqlite at the repo root (gitignored).
# Delete the file to reseed from the synthetic contacts.
REGISTRY_DB_PATH=
# Live demo: make a teammate's REAL phone the callback number for a contact, without
# committing it. Format BEACON_VERIFY_<CONTACT_ID>=<channel>:<handle>, e.g.
# BEACON_VERIFY_SAM=call:+1XXXXXXXXXX
# BEACON_VERIFY_SAM=

# --- Photon Spectrum ---
# From app.photon.codes → project settings.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Webhook signing secret from Photon dashboard for verifying POST /webhooks/photon
PHOTON_WEBHOOK_SECRET=
# terminal = type messages in your shell (no credentials); imessage = real line
CHANNELS_PROVIDER=terminal
BEACON_SERVER_URL=http://localhost:8787

# --- ElevenLabs Outbound Voice Callback (Photon SIP Trunk) ---
# Key from elevenlabs.io
ELEVENLABS_API_KEY=
# Conversational AI agent ID configured to ask the verification question
ELEVENLABS_AGENT_ID=
# Registered phone number ID linked to the Photon SIP trunk number (from /v1/convai/phone-numbers)
ELEVENLABS_PHONE_NUMBER_ID=
# Webhook signing secret from the ElevenLabs dashboard. REQUIRED for POST /webhooks/elevenlabs (401 without it); without it answers arrive by polling.
ELEVENLABS_WEBHOOK_SECRET=
# Telephony provider ("sip-trunk" by default, or "twilio")
ELEVENLABS_TELEPHONY_PROVIDER=sip-trunk
# Custom outbound URL override (optional)
ELEVENLABS_OUTBOUND_URL=
