{
  "name": "beacon",
  "private": true,
  "description": "Beacon — a scam-defense agent that verifies before you trust. HackUTD 2026.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,phone -c cyan,magenta \"pnpm -F @beacon/server dev\" \"pnpm -F @beacon/phone dev\"",
    "dev:server": "pnpm -F @beacon/server dev",
    "dev:phone": "pnpm -F @beacon/phone dev",
    "dev:channels": "pnpm -F @beacon/channels dev",
    "scenario": "pnpm -F @beacon/scenarios fire",
    "scenarios": "pnpm -F @beacon/scenarios list",
    "eval": "pnpm -F @beacon/scenarios eval",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -F @beacon/phone build",
    "check": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "protobufjs"
    ]
  }
}
